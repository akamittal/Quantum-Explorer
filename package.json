{
  "name": "quantum-explorer-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "frontend:dev": "npm run dev --workspace=frontend",
    "backend:dev": "npm run dev --workspace=backend",
    "dev": "concurrently \"npm run frontend:dev\" \"npm run backend:dev\"",
    "test": "npm run test --workspace=frontend",
    "build": "npm run build --workspace=frontend"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "katex": "^0.19.0",
    "react-katex": "^3.1.0"
  }
}
